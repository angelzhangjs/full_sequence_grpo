#!/bin/bash
# Run all i2v prompts with Sather Gate image

IMAGE_PATH="/home/ubuntu/angel-research/full_sequence_grpo/sather_gate.jpg"
OUTPUT_DIR="i2v_outputs_sather_gate"

# Create output directory
mkdir -p "$OUTPUT_DIR"

echo "========================================"
echo "Image-to-Video: Sather Gate"
echo "Running all prompts from i2v_examples.txt"
echo "========================================"
echo ""

# Check if image exists
if [ ! -f "$IMAGE_PATH" ]; then
    echo "Error: Image not found: $IMAGE_PATH"
    exit 1
fi

# Portrait animations (adapted for landscape/architecture)
prompts=(
"A woman smiling warmly and turning her head around."
"A woman's hair gently blowing in a soft breeze"
"A woman blinking naturally and smiling"
"A woman nodding her head in agreement"
"A woman tilting her head slightly with a thoughtful expression"
)

# Counter for output naming
counter=1

for prompt in "${prompts[@]}"; do
    echo "----------------------------------------"
    echo "[$counter/${#prompts[@]}] Generating: $prompt"
    echo "----------------------------------------"
    
    # Run i2v generation
    ./run_i2v.sh "$IMAGE_PATH" "$prompt" 125 42
    
    if [ $? -eq 0 ]; then
        echo "✅ Success!"
    else
        echo "❌ Failed"
    fi
    
    echo ""
    counter=$((counter + 1))
done

echo "========================================"
echo "All prompts completed!"
echo "========================================"
echo "Outputs saved to: ltx_video/outputs/"
echo ""
echo "You can find videos with names like:"
echo "  video_output_*_camera-slowly-panning-left-to-right_*.mp4"
echo "  video_output_*_gentle-wind-blowing-through-the_*.mp4"
echo "  etc."

