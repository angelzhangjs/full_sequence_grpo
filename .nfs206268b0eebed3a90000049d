#!/bin/bash
# Image-to-Video Generation Script for LTX-Video
# Usage: ./run_i2v.sh <image_path> <prompt> [num_frames] [seed]

# Check arguments
if [ $# -lt 2 ]; then
    echo "Usage: $0 <image_path> <prompt> [num_frames] [seed]"
    echo ""
    echo "Examples:"
    echo "  $0 input.jpg \"A woman smiling and looking at the camera\" 125 42"
    echo "  $0 tests/utils/woman.jpeg \"A woman turning her head slowly\" 97 123"
    echo ""
    exit 1
fi

IMAGE_PATH="$1"
PROMPT="$2"
NUM_FRAMES="${3:-125}"  # Default: 125 frames (5 seconds at 25fps)
SEED="${4:-42}"         # Default: 42

# Check if image exists
if [ ! -f "$IMAGE_PATH" ]; then
    echo "Error: Image file not found: $IMAGE_PATH"
    exit 1
fi

echo "========================================"
echo "LTX-Video Image-to-Video Generation"
echo "========================================"
echo "Input Image: $IMAGE_PATH"
echo "Prompt: $PROMPT"
echo "Frames: $NUM_FRAMES"
echo "Seed: $SEED"
echo "========================================"
echo ""

cd /home/ubuntu/angel-research/full_sequence_grpo/ltx_video

python run_inference.py \
    --pipeline_config configs/ltxv-2b-0.9.8-distilled-i2v.yaml \
    --input_media_path "$IMAGE_PATH" \
    --prompt "$PROMPT" \
    --height 512 \
    --width 768 \
    --num_frames "$NUM_FRAMES" \
    --frame_rate 25 \
    --seed "$SEED"

if [ $? -eq 0 ]; then
    echo ""
    echo "✅ Image-to-video generation complete!"
    echo "Output saved to: ltx_video/outputs/"
else
    echo ""
    echo "❌ Generation failed"
    exit 1
fi

