#!/bin/bash

# Script to run improved LTX-Video inference for all prompts in prompt.txt
# Uses the same VAE decoding and color normalization as pipeline.py
# Each prompt will be processed with the same parameters

cd /home/ubuntu/angel-research/full_sequence_grpo/ltx_video
#cd /home/ubuntu/angel-research/full_sequence_grpo

# Read prompt.txt line by line
PROMPT_FILE="/home/ubuntu/angel-research/full_sequence_grpo/physics_prompts.txt"
LINE_NUM=0

echo "========================================"
echo "Running LTX-Video inference for all prompts"
echo "========================================"
echo ""

while IFS= read -r prompt || [ -n "$prompt" ]; do
    # Skip empty lines
    if [ -z "$prompt" ]; then
        continue
    fi
    
    LINE_NUM=$((LINE_NUM + 1))
    
    echo "----------------------------------------"
    echo "Processing prompt $LINE_NUM: $prompt"
    echo "----------------------------------------"
    
    # Run inference with the current prompt
    python run_inference.py \
        --pipeline_config configs/ltxv-2b-0.9.8-distilled.yaml \
        --prompt "$prompt" \
        --height 512 \
        --width 768 \
        --num_frames 125 \
        --frame_rate 25 \
        --seed 42
    
    # Check if the command succeeded
    if [ $? -eq 0 ]; then
        echo "✅ Successfully generated video for prompt $LINE_NUM"
    else
        echo "❌ Failed to generate video for prompt $LINE_NUM"
    fi
    
    echo ""
    
done < "$PROMPT_FILE"

echo "========================================"
echo "All prompts processed!"
echo "========================================"
echo "Output videos saved to: ltx_video/outputs/"

